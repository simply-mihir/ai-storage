{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "streamlit",
      "runtimeExecutable": ".venv/bin/streamlit",
      "runtimeArgs": ["run", "app/streamlit_app.py", "--server.port", "8501", "--server.headless", "true"],
      "port": 8501
    },
    {
      "name": "fastapi",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["storage_advisor.app.api:app", "--host", "0.0.0.0", "--port", "8001", "--reload"],
      "port": 8001
    }
  ]
}
